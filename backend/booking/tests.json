{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without date",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "POST missing fields",
      "method": "POST",
      "path": "/",
      "body": {"name": "", "phone": ""},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "GET by unknown token",
      "method": "GET",
      "path": "/?token=00000000-0000-0000-0000-000000000000",
      "expectedStatus": 404,
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE without token",
      "method": "DELETE",
      "path": "/",
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "PUT without token",
      "method": "PUT",
      "path": "/",
      "body": {"date": "2026-09-01", "time": "10:00"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    }
  ]
}